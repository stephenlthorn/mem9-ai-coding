# ── mem9 space credentials ──────────────────────────────────────────────────
# Create a free space at mem9.ai/console - paste the key it gives you here.
# This single key unlocks TiDB Cloud (vector + full-text + hybrid recall)
# without managing any database credentials directly.
MEM9_API_KEY=

# Optional: override the mem9 API endpoint (default: https://api.mem9.ai)
# MEM9_BASE_URL=https://api.mem9.ai

# ── mem9 topology ────────────────────────────────────────────────────────────
# Team = mem9 space. Repo = appId namespace within it ({team}_{repo}_kb).
MEM9_TEAM=acme

# Optional namespace version suffix -> appId becomes {team}_{repo}_kb_{version}.
# mem9 spaces accumulate history and list reads are eventually consistent; bump
# this to start from a pristine namespace without changing the team/repo model.
# MEM9_NS_VERSION=demo

# ── Isolation demo (Scenario C) - optional ───────────────────────────────────
# Create a second mem9 space at mem9.ai/console and paste its key here to run
# the live team-isolation check (python -m src.isolation_check).
# MEM9_ISOLATION_KEY=

# ── Dashboard (optional appendix) ────────────────────────────────────────────
DASHBOARD_PORT=7001

# MiniMax M3 (OpenAI-compatible) - used by codex --profile minimax for demo Step 2
# MINIMAX_API_KEY=
